<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TvPlayer" parent="Theme.Leanback">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/vp_teal</item>
        <item name="colorAccent">@color/vp_blue</item>
        <item name="android:colorAccent">@color/vp_blue</item>
    </style>

    <style name="Theme.TvPlayer.Splash.Base" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/vp_teal_dark</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.TvPlayer.Splash" parent="Theme.TvPlayer.Splash.Base" />

    <style name="Theme.TvPlayer.Settings" parent="Theme.TvPlayer">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Leanback</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.TvPlayer.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/brand_red</item>
    </style>

    <style name="Widget.TvPlayer.ControlButton" parent="">
        <item name="android:layout_width">@dimen/player_button_size</item>
        <item name="android:layout_height">@dimen/player_button_size</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_player_button</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/player_icon</item>
    </style>

    <style name="Widget.TvPlayer.PlayPauseButton" parent="Widget.TvPlayer.ControlButton">
        <item name="android:layout_width">@dimen/player_play_button_size</item>
        <item name="android:layout_height">@dimen/player_play_button_size</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_play_pause</item>
        <item name="android:padding">23dp</item>
    </style>

    <style name="TextAppearance.TvPlayer.SidebarHeader" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TextAppearance.TvPlayer.SidebarItem" parent="android:TextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.TvPlayer.SidebarItemFocused" parent="TextAppearance.TvPlayer.SidebarItem">
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
